#!/usr/bin/env bash
# dev-process — resolve and print the DEV_PROCESS.md that governs a repository.
#
#   dev-process path [--repo <dir>]              the resolved file
#   dev-process show [<section>] [--repo <dir>]  the file, or one `## ` section by its first word
#   dev-process get <key> [--repo <dir>]         one frontmatter value
#
# Lookup: <repo>/DEV_PROCESS.md, then ~/.claude/DEV_PROCESS.md, then the plugin default. <repo> is
# --repo, else $CLAUDE_PROJECT_DIR, else the cwd's git toplevel, else the cwd.
set -euo pipefail

DEFAULT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)/context/dev-process.default.md"

die() { echo "dev-process: $1" >&2; exit 1; }
usage() { sed -n '4,6s/^#   //p' "$0" >&2; exit 1; }

repo=""
args=()
while (( $# )); do
  case "$1" in
    --repo) [[ $# -ge 2 && -d "$2" ]] || usage; repo="$2"; shift 2 ;;
    -*) usage ;;
    *) args+=("$1"); shift ;;
  esac
done
set -- "${args[@]+"${args[@]}"}"

resolve() {
  local dir="${repo:-${CLAUDE_PROJECT_DIR:-}}" f
  [[ -n "$dir" ]] || dir="$(git rev-parse --show-toplevel 2>/dev/null)" || dir="$PWD"
  # A cloned repository could point a symlink anywhere, so the repo tier refuses one.
  [[ -f "$dir/DEV_PROCESS.md" && ! -L "$dir/DEV_PROCESS.md" ]] && { printf '%s\n' "$dir/DEV_PROCESS.md"; return; }
  for f in "$HOME/.claude/DEV_PROCESS.md" "$DEFAULT"; do
    [[ -f "$f" ]] && { printf '%s\n' "$f"; return; }
  done
  die "no DEV_PROCESS.md found and the plugin default is missing at $DEFAULT"
}

case "${1:-}" in
  path)
    (( $# == 1 )) || usage
    resolve ;;
  show)
    (( $# <= 2 )) || usage
    file="$(resolve)"
    [[ -n "${2:-}" ]] || { cat "$file"; exit 0; }
    # A `## ` line inside a fenced block (a ticket template) is not a section heading.
    awk -v want="$(tr '[:upper:]' '[:lower:]' <<<"$2")" '
      /^```/ { fence = !fence }
      !fence && /^## / { w = tolower($2); sub(/[^a-z].*/, "", w); on = (w == want); if (on) found = 1 }
      on { print }
      END { exit !found }
    ' "$file" || die "no section '$2' in $file" ;;
  get)
    (( $# == 2 )) || usage
    file="$(resolve)"
    awk -v key="$2" '
      NR == 1 && $0 == "---" { fm = 1; next }
      $0 == "---" { exit }
      fm && index($0, key ":") == 1 { v = substr($0, length(key) + 2); gsub(/^[ \t]+|[ \t]+$/, "", v); print v; found = 1; exit }
      END { exit !found }
    ' "$file" || die "no frontmatter key '$2' in $file" ;;
  *)
    usage ;;
esac
