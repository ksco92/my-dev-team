#!/usr/bin/env bash
# lesson-lint — checks learned-pattern bullets for register faults before a reviewer reads them.
#
# Usage:
#   lesson-lint <file>...                    every bullet under `## Learned patterns`, and every
#                                            bullet of a context/tpm/*.md file
#   lesson-lint --added <base-ref> <file>... only bullets whose whitespace-collapsed text is absent from the merge base's copy;
#                                            every bullet of an untracked file
#
# Prints `<file>:<line>: <rule>: <first 60 chars>` per failure and exits 1 on any; a section
# over its bullet budget is a warning on stderr. Exit 2 on a usage error.
set -euo pipefail

usage() { sed -n '4,8p' "$0" | sed 's/^# \{0,1\}//' >&2; exit 2; }

base=""
if [[ "${1:-}" == "--added" ]]; then
  [[ $# -ge 3 ]] || usage
  base="$2"; shift 2
fi
[[ $# -ge 1 && "$1" != -* ]] || usage

status=0
for file in "$@"; do
  [[ -f "$file" ]] || { echo "lesson-lint: no such file: $file" >&2; exit 2; }
  case "$file" in
    context/tpm/*.md | */context/tpm/*.md) whole=1 budget=30 ;;
    *-coding-guide.md | *baseline.md | *npm-publishing-pattern.md) whole=0 budget=25 ;;
    *) whole=0 budget=20 ;;
  esac
  base_text="" mode=""
  if [[ -n "$base" ]] && git -C "$(dirname "$file")" ls-files --error-unmatch -- "$(basename "$file")" >/dev/null 2>&1; then
    mode=added
    # A bullet is unchanged when its whitespace-collapsed text exists in the merge base's copy.
    merge_base="$(git -C "$(dirname "$file")" merge-base "$base" HEAD)" \
      || { echo "lesson-lint: no merge base with '$base' for $file" >&2; exit 2; }
    base_text="$(git -C "$(dirname "$file")" show "$merge_base:./$(basename "$file")" 2>/dev/null || true)"
  fi
  awk -v file="$file" -v whole="$whole" -v budget="$budget" -v mode="$mode" '
    function flush(   t) {
      if (start == 0) return
      t = body; gsub(/[[:space:]]+/, " ", t); sub(/^ /, "", t); sub(/ $/, "", t)
      if (inbase) { baseset[t] = 1; start = 0; return }
      n++; text[n] = t; line[n] = start; start = 0; pick[n] = (mode != "added" || !(t in baseset))
    }
    function fail(i, rule) { printf "%s:%d: %s: %s\n", file, line[i], rule, substr(text[i], 1, 60); bad = 1 }
    FNR == 1 { flush(); fence = 0; insec = 0; filenum++; inbase = (mode == "added" && filenum == 1) }
    /^(```|~~~)/ { flush(); fence = !fence; next }
    fence { next }
    /^#+ / {
      flush()
      if (!whole && /^## /) insec = ($0 ~ /^## Learned patterns[[:space:]]*$/)
      if (!whole && /^# /) insec = 0
      next
    }
    /^[[:space:]]*[-*] / && (whole || insec) { flush(); start = FNR; body = $0; sub(/^[[:space:]]*[-*] /, "", body); next }
    /^[[:space:]]*$/ { flush(); next }
    start { sub(/^[[:space:]]+/, ""); body = body " " $0; next }
    END {
      flush()
      for (i = 1; i <= n; i++) {
        count[text[i]]++
      }
      if (n > budget) printf "%s: warning: budget: %d bullets, budget %d\n", file, n, budget > "/dev/stderr"
      for (i = 1; i <= n; i++) {
        if (!pick[i]) continue
        t = text[i]; lower = tolower(t); padded = " " t " "; lpadded = " " lower " "
        plain = t; gsub(/`[^`]*`/, "", plain); sub(/[[:space:]]+$/, "", plain)
        if (gsub(/[.!?] /, "&", plain) + 1 > 2) fail(i, "sentences")
        if (t ~ /[0-9][0-9][0-9][0-9][-\/][0-9][0-9]?[-\/][0-9][0-9]?/ ||
            padded ~ /[^A-Za-z](Jan|January|Feb|February|Mar|March|Apr|April|May|Jun|June|Jul|July|Aug|August|Sep|Sept|September|Oct|October|Nov|November|Dec|December)\.? ([0-9][0-9]?,? )?(19|20)[0-9][0-9][^0-9]/)
          fail(i, "date")
        if (t ~ /#[0-9]/ || t ~ /\/(pull|issues)\/[0-9]/ || padded ~ /[^A-Za-z]PR( |-)?[0-9]/ || padded ~ /[^A-Za-z][Ii]ssue [0-9]/)
          fail(i, "ticket")
        if (lower ~ /claude-([a-z]+-)?[0-9]/ || lower ~ /(opus|sonnet|haiku|fable)[- ][0-9]/) fail(i, "model-id")
        rest = t
        while (match(rest, /~\/\.claude\/[^[:space:]`'"'"'"),;]*/)) {
          p = substr(rest, RSTART, RLENGTH); rest = substr(rest, RSTART + RLENGTH); sub(/[.:]+$/, "", p)
          if (p !~ /^~\/\.claude\/(DEV_PROCESS\.md|gate-ledger|settings\.json|projects)(\/|$)/) { fail(i, "claude-path"); break }
        }
        if (lpadded ~ /[^a-z](added after|after observing|observed in|learned from)[^a-z]/ || padded ~ /[^A-Za-z]in PR[^A-Za-z-]/)
          fail(i, "incident")
        if (count[text[i]] > 1) fail(i, "duplicate")
        if (t ~ /^[a-z]/) fail(i, "lowercase")
      }
      exit bad
    }
  ' <(printf '# base\n%s\n' "$base_text") "$file" || status=1
done
exit "$status"
